  "title": "the p=41 next all-finite endpoint is impossible",
  "tangent_envelope_input": {
    "external_dependency": true,
    "source": "S. Ball and M. Lavrauw, Planar arcs, Journal of Combinatorial Theory Series A 160 (2018), 261-287",
